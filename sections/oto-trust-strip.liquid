{{ 'oto-home.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <section class="oto-trust" aria-label="Why shop with us" {{ section.shopify_attributes }}>
    <ul class="oto-container oto-trust__grid" style="--oto-cols: {{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <li class="oto-trust__item" {{ block.shopify_attributes }}>
          {% render 'oto-icon', name: block.settings.icon %}
          <span>{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "OTO Trust Strip",
  "tag": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Trust point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "headset", "label": "Headset" },
            { "value": "heart", "label": "Heart" },
            { "value": "bolt", "label": "Bolt" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "100% Natural Formula" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OTO Trust Strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "leaf", "text": "100% Natural Formula" } },
        { "type": "item", "settings": { "icon": "shield", "text": "Trusted by Thousands" } },
        { "type": "item", "settings": { "icon": "star", "text": "Satisfaction Guaranteed" } }
      ]
    }
  ]
}
{% endschema %}
