{{ 'oto-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign form_id = 'oto-pdp-form-' | append: section.id
  assign images = product.media | where: 'media_type', 'image'
-%}

<section class="oto-pdp" data-oto-product {{ section.shopify_attributes }}>
  <div class="oto-container">
    <ul class="oto-crumbs" aria-label="Breadcrumb">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><a href="{{ routes.all_products_collection_url }}">Products</a></li>
      <li aria-current="page">{{ product.title }}</li>
    </ul>

    <div class="oto-pdp__grid">
      <div class="oto-pdp__gallery">
        <div class="oto-card oto-pdp__main">
          <span data-oto-pill>{% render 'oto-save-pill', variant: current %}</span>
          {%- if images.size > 0 -%}
            {{
              images.first
              | image_url: width: 1400
              | image_tag:
                widths: '600, 900, 1200, 1400',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: images.first.alt | default: product.title,
                data-oto-main: true
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if images.size > 1 -%}
          <ul class="oto-pdp__thumbs">
            {%- for image in images -%}
              <li>
                <button
                  type="button"
                  aria-label="{{ 'Show image' }} {{ forloop.index }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-oto-thumb
                  data-src="{{ image | image_url: width: 1400 }}"
                  data-srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1400 }} 1400w"
                  data-alt="{{ image.alt | default: product.title | escape }}"
                >
                  {{ image | image_url: width: 160 | image_tag: width: 80, loading: 'lazy', alt: '' }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="oto-pdp__info">
        {%- if section.settings.eyebrow != blank -%}<p class="oto-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="oto-h2 oto-pdp__title">{{ product.title }}</h1>
        {%- if product.vendor != blank and section.settings.show_vendor -%}<p class="oto-pdp__sub">{{ product.vendor }}</p>{%- endif -%}

        <div data-oto-price>
          {% render 'oto-price', variant: current, boxes: section.settings.boxes, large: true %}
        </div>

        {%- if product.description != blank -%}
          <p class="oto-pdp__lead">{{ product.description | strip_html | truncate: 220 }}</p>
        {%- endif -%}

        {%- assign benefits = section.blocks | where: 'type', 'benefit' -%}
        {%- if benefits.size > 0 -%}
          <ul class="oto-benefits">
            {%- for block in benefits -%}
              <li {{ block.shopify_attributes }}>{% render 'oto-icon', name: block.settings.icon %}{{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <product-form class="oto-atc oto-pdp__buy" data-section-id="{{ section.id }}">
          <div class="product-form__error-message-wrapper oto-atc__error" role="alert" hidden>
            <span class="product-form__error-message"></span>
          </div>
          {%- form 'product', product, id: form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            {%- if product.has_only_default_variant -%}
              <input type="hidden" name="id" value="{{ current.id }}"{% unless current.available %} disabled{% endunless %}>
            {%- else -%}
              <label class="oto-pdp__label" for="oto-variant-{{ section.id }}">{{ 'Option' }}</label>
              <select class="oto-select" id="oto-variant-{{ section.id }}" name="id" data-oto-variant>
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price | money }}"
                    data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                    data-available="{{ variant.available }}"
                    {% if variant == current %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{- variant.title }} - {{ variant.price | money -}}
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            <div class="oto-pdp__row">
              <div class="oto-qty">
                <label class="oto-sr" for="oto-qty-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
                <button type="button" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}" data-oto-qty="-1">&minus;</button>
                <input id="oto-qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                <button type="button" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}" data-oto-qty="1">+</button>
              </div>
              <button
                type="submit"
                name="add"
                class="oto-btn oto-btn--primary oto-btn--lg oto-btn--block product-form__submit"
                {% unless current.available %}disabled{% endunless %}
              >
                <span>
                  {%- if current.available and section.settings.button_label != blank -%}
                    {{ section.settings.button_label }}
                  {%- elsif current.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
                {%- render 'loading-spinner' -%}
              </button>
            </div>
          {%- endform -%}
        </product-form>
        {%- if section.settings.note != blank -%}
          <p class="oto-note">{% render 'oto-icon', name: 'lock' %}{{ section.settings.note }}</p>
        {%- endif -%}

        {%- assign trusts = section.blocks | where: 'type', 'trust' -%}
        {%- if trusts.size > 0 -%}
          <ul class="oto-pdp__trust">
            {%- for block in trusts -%}
              <li {{ block.shopify_attributes }}>{% render 'oto-icon', name: block.settings.icon %}{{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="oto-faq__list oto-pdp__acc" data-oto-faq>
          {%- if product.description != blank -%}
            <details class="oto-faq__item" open>
              <summary>{{ 'Description' }}{% render 'oto-icon', name: 'plus' %}</summary>
              <div class="oto-faq__body rte">{{ product.description }}</div>
            </details>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <details class="oto-faq__item" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading }}{% render 'oto-icon', name: 'plus' %}</summary>
                <div class="oto-faq__body rte">{{ block.settings.content }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<div class="oto-sticky" data-oto-sticky aria-hidden="true">
  {%- if images.size > 0 -%}{{ images.first | image_url: width: 120 | image_tag: width: 48, loading: 'lazy', alt: '' }}{%- endif -%}
  <div>
    <strong>{{ product.title }}</strong>
    <span data-oto-sticky-price>{{ current.price | money }}</span>
  </div>
  <button type="submit" form="{{ form_id }}" class="oto-btn oto-btn--primary" tabindex="-1" {% unless current.available %}disabled{% endunless %}>
    {{- section.settings.button_label | default: 'Add to cart' -}}
  </button>
</div>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'oto-faq.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'oto-product.js' | asset_url }}" defer="defer"></script>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "OTO Product",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Pack of 3" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "range", "id": "boxes", "label": "Boxes per pack", "info": "Used for the per-box price. Set to 1 to hide it.", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add 3-Pack to Cart" },
    { "type": "text", "id": "note", "label": "Note under button", "default": "Secure checkout · Discreet packaging" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "bars", "label": "Bars" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "check", "label": "Check" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Natural health product" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust point",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "headset", "label": "Headset" },
            { "value": "shield", "label": "Shield" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Plain, unmarked packaging" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "How to use" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add the information here.</p>" }
      ]
    }
  ]
}
{% endschema %}
