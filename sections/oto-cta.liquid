{{ 'oto-home.css' | asset_url | stylesheet_tag }}

<section class="oto-cta" {{ section.shopify_attributes }}>
  <picture class="oto-cta__bg">
    {%- if section.settings.image_mobile != blank -%}
      <source
        media="(max-width: 749px)"
        srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
        sizes="100vw"
      >
    {%- endif -%}
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag: widths: '750, 1100, 1500, 2000', sizes: '100vw', loading: 'lazy', alt: ''
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </picture>
  <div class="oto-container oto-cta__inner">
    <div class="oto-cta__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="oto-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="oto-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="oto-cta__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="oto-btn oto-btn--primary oto-btn--lg" href="{{ section.settings.button_link | default: '#' }}">
          {{- section.settings.button_label }} {% render 'oto-icon', name: 'arrow' -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OTO Final CTA",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Background image (mobile, optional)" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Take control today" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Stronger, Happier You" },
    { "type": "text", "id": "text", "label": "Text", "default": "Natural. Discreet. Trusted. OTO Men's Care." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "OTO Final CTA" }]
}
{% endschema %}
