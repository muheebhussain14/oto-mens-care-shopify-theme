{{ 'oto-home.css' | asset_url | stylesheet_tag }}

<section class="oto-panel" id="oto-faq" style="--oto-panel-bg: {{ section.settings.background_color }}; --oto-panel-text: {{ section.settings.text_color }}; --oto-panel-overlay: {{ section.settings.overlay | divided_by: 100.0 }}; --oto-pt: {{ section.settings.padding_top }}px; --oto-pb: {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}>
  {%- if section.settings.background_image != blank -%}
    <div class="oto-panel__bg">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: widths: '750, 1100, 1500, 2000', sizes: '100vw', loading: 'lazy', alt: '' }}
    </div>
    <div class="oto-panel__overlay"></div>
  {%- endif -%}
  <div class="oto-container oto-faq__grid">
    <div class="oto-faq__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="oto-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="oto-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="oto-head__sub">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.help_heading != blank -%}
        <div class="oto-darkcard oto-help">
          {% render 'oto-icon', name: 'help' %}
          <div>
            <strong>{{ section.settings.help_heading }}</strong>
            <p>{{ section.settings.help_text }}</p>
            {%- if section.settings.help_button_label != blank -%}
              <a class="oto-btn oto-btn--primary" href="{{ section.settings.help_button_link | default: '#' }}">{{ section.settings.help_button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
    <div class="oto-faq__list" data-oto-faq>
      {%- for block in section.blocks -%}
        <details class="oto-faq__item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
          <summary>{{ block.settings.question }}{% render 'oto-icon', name: 'plus' %}</summary>
          <div class="oto-faq__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  <script src="{{ 'oto-faq.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "OTO FAQ",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#950C13" },
    { "type": "image_picker", "id": "background_image", "label": "Background image (optional)", "info": "Shown behind the content, tinted with the background color." },
    { "type": "range", "id": "overlay", "label": "Image tint strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70 },
    { "type": "color", "id": "text_color", "label": "Heading and text color", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Questions?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "text", "label": "Supporting text", "default": "Everything you need to know before you order." },
    { "type": "header", "content": "Support card" },
    { "type": "text", "id": "help_heading", "label": "Heading", "default": "Still have questions?" },
    { "type": "text", "id": "help_text", "label": "Text", "default": "Our support team is here to help." },
    { "type": "text", "id": "help_button_label", "label": "Button label", "default": "Contact Us" },
    { "type": "url", "id": "help_button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is OTO and how does it work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add the answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OTO FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "What is OTO and how does it work?", "answer": "<p>Add the answer here.</p>" } },
        { "type": "faq", "settings": { "question": "Is it safe to use?", "answer": "<p>Add the answer here.</p>" } },
        { "type": "faq", "settings": { "question": "Will my order be discreetly packaged?", "answer": "<p>Add the answer here.</p>" } }
      ]
    }
  ]
}
{% endschema %}
