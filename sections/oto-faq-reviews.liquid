{{ 'oto-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign review_count = 0
  assign faq_count = 0
  for block in section.blocks
    if block.type == 'review'
      assign review_count = review_count | plus: 1
    elsif block.type == 'faq'
      assign faq_count = faq_count | plus: 1
    endif
  endfor
-%}

<section class="oto-section oto-redpanel" id="oto-faq" {{ section.shopify_attributes }}>
  <div class="oto-container">

    {%- if review_count > 0 -%}
      <div class="oto-redpanel__block">
        <header class="oto-head">
          {%- if section.settings.reviews_eyebrow != blank -%}<p class="oto-eyebrow">{{ section.settings.reviews_eyebrow }}</p>{%- endif -%}
          {%- if section.settings.reviews_heading != blank -%}<h2 class="oto-h2">{{ section.settings.reviews_heading }}</h2>{%- endif -%}
        </header>
        <div class="oto-grid-3">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <figure class="oto-darkcard oto-review" {{ block.shopify_attributes }}>
                <div class="oto-stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.rating -%}
                      {% render 'oto-icon', name: 'star' %}
                    {%- else -%}
                      {% render 'oto-icon', name: 'star', class: 'oto-icon--off' %}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <blockquote>&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
                <figcaption>
                  <strong>{{ block.settings.name }}</strong>
                  {%- if block.settings.verified -%}
                    <span class="oto-review__verified">{% render 'oto-icon', name: 'check' %}Verified purchase</span>
                  {%- endif -%}
                </figcaption>
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if faq_count > 0 -%}
      <div class="oto-redpanel__block oto-faq__grid">
        <div class="oto-faq__intro">
          {%- if section.settings.faq_eyebrow != blank -%}<p class="oto-eyebrow">{{ section.settings.faq_eyebrow }}</p>{%- endif -%}
          {%- if section.settings.faq_heading != blank -%}<h2 class="oto-h2">{{ section.settings.faq_heading }}</h2>{%- endif -%}
          {%- if section.settings.faq_text != blank -%}<p class="oto-head__sub">{{ section.settings.faq_text }}</p>{%- endif -%}
          {%- if section.settings.help_heading != blank -%}
            <div class="oto-darkcard oto-help">
              {% render 'oto-icon', name: 'help' %}
              <div>
                <strong>{{ section.settings.help_heading }}</strong>
                <p>{{ section.settings.help_text }}</p>
                {%- if section.settings.help_button_label != blank -%}
                  <a class="oto-btn oto-btn--primary" href="{{ section.settings.help_button_link | default: '#' }}">{{ section.settings.help_button_label }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
        <div class="oto-faq__list" data-oto-faq>
          {%- assign faq_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              {%- assign faq_index = faq_index | plus: 1 -%}
              <details class="oto-faq__item" {{ block.shopify_attributes }}{% if faq_index == 1 %} open{% endif %}>
                <summary>{{ block.settings.question }}{% render 'oto-icon', name: 'plus' %}</summary>
                <div class="oto-faq__body rte">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if faq_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign faq_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            {%- assign faq_index = faq_index | plus: 1 -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
            }{% unless faq_index == faq_count %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
  <script src="{{ 'oto-faq.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "OTO Reviews + FAQ",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Customer reviews" },
    { "type": "text", "id": "reviews_eyebrow", "label": "Small label", "default": "Real results" },
    { "type": "text", "id": "reviews_heading", "label": "Heading", "default": "What Our Customers Say" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_eyebrow", "label": "Small label", "default": "Questions?" },
    { "type": "text", "id": "faq_heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "faq_text", "label": "Supporting text", "default": "Everything you need to know before you order." },
    { "type": "header", "content": "Support card" },
    { "type": "text", "id": "help_heading", "label": "Heading", "default": "Still have questions?" },
    { "type": "text", "id": "help_text", "label": "Text", "default": "Our support team is here to help." },
    { "type": "text", "id": "help_button_label", "label": "Button label", "default": "Contact Us" },
    { "type": "url", "id": "help_button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "Add a short customer review here." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "James T." },
        { "type": "checkbox", "id": "verified", "label": "Show \"Verified purchase\"", "info": "Only enable for real, verified reviews.", "default": false }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is OTO and how does it work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add the answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OTO Reviews + FAQ",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "quote": "Add a short customer review here.", "name": "Customer name" } },
        { "type": "review", "settings": { "rating": 5, "quote": "Add a short customer review here.", "name": "Customer name" } },
        { "type": "review", "settings": { "rating": 5, "quote": "Add a short customer review here.", "name": "Customer name" } },
        { "type": "faq", "settings": { "question": "What is OTO and how does it work?", "answer": "<p>Add the answer here.</p>" } },
        { "type": "faq", "settings": { "question": "Is it safe to use?", "answer": "<p>Add the answer here.</p>" } },
        { "type": "faq", "settings": { "question": "Will my order be discreetly packaged?", "answer": "<p>Add the answer here.</p>" } }
      ]
    }
  ]
}
{% endschema %}
