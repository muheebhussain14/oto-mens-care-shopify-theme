{%- unless request.design_mode or section.settings.enabled == false -%}
  {{ 'oto-age-gate.css' | asset_url | stylesheet_tag }}
  <div
    class="oto-age"
    data-oto-age
    data-days="{{ section.settings.remember_days }}"
    role="dialog"
    aria-modal="true"
    aria-labelledby="OtoAgeTitle"
    hidden
  >
    <div class="oto-age__box">
      <h2 id="OtoAgeTitle">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      <div class="oto-age__btns">
        <button type="button" class="oto-btn oto-btn--primary" data-oto-age-yes>{{ section.settings.yes_label }}</button>
        <a class="oto-btn oto-btn--ghost" href="{{ section.settings.exit_url | default: 'https://www.google.com' }}" rel="noopener">{{ section.settings.no_label }}</a>
      </div>
    </div>
  </div>
  <script src="{{ 'oto-age-gate.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{% schema %}
{
  "name": "OTO Age Gate",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the age gate", "default": true, "info": "Hidden automatically inside the theme editor." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Are you 21 or older?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "You must be 21 years of age or older to enter OTO Men's Care." },
    { "type": "text", "id": "yes_label", "label": "Confirm button", "default": "YES, I'M 21+" },
    { "type": "text", "id": "no_label", "label": "Leave button", "default": "LEAVE SITE" },
    { "type": "url", "id": "exit_url", "label": "Leave button link", "info": "Where under-21 visitors are sent. Defaults to google.com." },
    { "type": "range", "id": "remember_days", "label": "Remember the answer (days)", "min": 1, "max": 90, "step": 1, "default": 30 }
  ]
}
{% endschema %}
