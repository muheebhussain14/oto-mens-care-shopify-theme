{{ 'oto-home.css' | asset_url | stylesheet_tag }}

{%- assign product = section.settings.product -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- if section.settings.custom_image != blank -%}
  {%- assign image = section.settings.custom_image -%}
{%- else -%}
  {%- assign image = product.featured_media.preview_image -%}
{%- endif -%}

<section class="oto-featured" id="oto-featured" {{ section.shopify_attributes }}>
  {%- if section.settings.background != blank -%}
    <div class="oto-featured__bg">
      {{
        section.settings.background
        | image_url: width: 2000
        | image_tag: widths: '750, 1100, 1500, 2000', sizes: '100vw', loading: 'lazy', alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="oto-container oto-featured__grid">
    <div class="oto-featured__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="oto-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="oto-h2">
        {%- if section.settings.heading_accent != blank -%}<span class="oto-accent">{{ section.settings.heading_accent }}</span><br>{%- endif -%}
        {{- section.settings.heading | default: product.title -}}
      </h2>
      <div class="oto-featured__text rte">{{ section.settings.text }}</div>

      {%- if section.blocks.size > 0 -%}
        <ul class="oto-benefits">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'oto-icon', name: block.settings.icon %}{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if product != blank -%}
        {%- assign form_id = 'oto-featured-' | append: section.id -%}
        {% render 'oto-price', variant: variant, large: true %}
        <div class="oto-featured__buy">
          {% render 'oto-add-to-cart', product: product, label: section.settings.button_label, form_id: form_id, class: 'oto-btn--lg' %}
          {%- if section.settings.note != blank -%}
            <p class="oto-note">{% render 'oto-icon', name: 'lock' %}{{ section.settings.note }}</p>
          {%- endif -%}
        </div>
      {%- else -%}
        <p class="oto-note">Select a product in the theme editor.</p>
      {%- endif -%}
    </div>

    <div class="oto-featured__visual">
      {%- if section.settings.badge_number != blank or section.settings.badge_label != blank -%}
        <div class="oto-badge"><strong>{{ section.settings.badge_number }}</strong><span>{{ section.settings.badge_label }}</span></div>
      {%- endif -%}
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 1200
          | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 750px) 40vw, 100vw', loading: 'lazy', alt: image.alt | default: product.title
        }}
      {%- else -%}
        {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OTO Featured Product",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Title, price, compare-at price, image and Add to Cart come from this product." },
    { "type": "image_picker", "id": "custom_image", "label": "Custom product image (optional)", "info": "Replaces the product photo in this section. Leave empty to use the selected product's main image." },
    { "type": "image_picker", "id": "background", "label": "Background image (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Featured product" },
    { "type": "text", "id": "heading_accent", "label": "Heading first line (red)", "default": "OTO Original" },
    { "type": "text", "id": "heading", "label": "Heading second line (white)", "info": "Leave empty to use the product title.", "default": "The Trusted Choice" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Our best-selling formula is a natural health product designed to enhance vitality, increase vigour and support prolonged performance.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add 3-Pack to Cart" },
    { "type": "text", "id": "note", "label": "Note under button", "default": "Secure checkout · Discreet packaging" },
    { "type": "header", "content": "Badge" },
    { "type": "text", "id": "badge_number", "label": "Badge top text", "default": "#1" },
    { "type": "text", "id": "badge_label", "label": "Badge bottom text", "default": "Bestseller" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "bars", "label": "Bars" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" },
            { "value": "check", "label": "Check" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Natural ingredients" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OTO Featured Product",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "leaf", "text": "Natural ingredients" } },
        { "type": "benefit", "settings": { "icon": "bolt", "text": "Boosts stamina" } },
        { "type": "benefit", "settings": { "icon": "bars", "text": "Supports performance" } },
        { "type": "benefit", "settings": { "icon": "heart", "text": "Greater confidence" } }
      ]
    }
  ]
}
{% endschema %}
