{{ 'oto-home.css' | asset_url | stylesheet_tag }}

<section class="oto-panel" id="oto-reviews" style="--oto-panel-bg: {{ section.settings.background_color }}; --oto-panel-text: {{ section.settings.text_color }}; --oto-panel-overlay: {{ section.settings.overlay | divided_by: 100.0 }}; --oto-pt: {{ section.settings.padding_top }}px; --oto-pb: {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}>
  {%- if section.settings.background_image != blank -%}
    <div class="oto-panel__bg">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: widths: '750, 1100, 1500, 2000', sizes: '100vw', loading: 'lazy', alt: '' }}
    </div>
    <div class="oto-panel__overlay"></div>
  {%- endif -%}
  <div class="oto-container" style="--oto-review-cols: {{ section.settings.columns }}">
    <header class="oto-head">
      {%- if section.settings.eyebrow != blank -%}<p class="oto-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="oto-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    </header>
    <div class="oto-reviews-grid">
      {%- for block in section.blocks -%}
        <figure class="oto-darkcard oto-review" {{ block.shopify_attributes }}>
          <div class="oto-stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.rating -%}
                {% render 'oto-icon', name: 'star' %}
              {%- else -%}
                {% render 'oto-icon', name: 'star', class: 'oto-icon--off' %}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <blockquote>&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
          <figcaption>
            <strong>{{ block.settings.name }}</strong>
            {%- if block.settings.verified -%}
              <span class="oto-review__verified">{% render 'oto-icon', name: 'check' %}Verified purchase</span>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OTO Reviews",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#950C13" },
    { "type": "image_picker", "id": "background_image", "label": "Background image (optional)", "info": "Shown behind the content, tinted with the background color." },
    { "type": "range", "id": "overlay", "label": "Image tint strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70 },
    { "type": "color", "id": "text_color", "label": "Heading and text color", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Real results" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" },
    { "type": "select", "id": "columns", "label": "Reviews per row (desktop)", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }] }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "Add a real customer review here." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Show \"Verified purchase\"", "info": "Only enable for real, verified reviews.", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "OTO Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
