{{ 'oto-home.css' | asset_url | stylesheet_tag }}
{%- style -%}
  @font-face {
    font-family: 'Mr Dafoe';
    src: url('{{ 'oto-script.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
{%- endstyle -%}

<section class="oto-hero" {{ section.shopify_attributes }}>
  <picture class="oto-hero__bg">
    {%- if section.settings.image_mobile != blank -%}
      <source
        media="(max-width: 749px)"
        srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
        sizes="100vw"
      >
    {%- endif -%}
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </picture>

  <div class="oto-container oto-hero__grid">
    <div class="oto-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="oto-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="oto-h1">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_accent != blank -%}<br><span class="oto-accent">{{ section.settings.heading_accent }}</span>{%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="oto-hero__lead">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="oto-btn oto-btn--primary oto-btn--lg" href="{{ section.settings.button_link | default: '#' }}">
          {{- section.settings.button_label }} {% render 'oto-icon', name: 'arrow' -%}
        </a>
      {%- endif -%}
    </div>
    <div class="oto-hero__visual">
      {%- if section.settings.tagline_1 != blank -%}
        <p class="oto-hero__tagline" aria-hidden="true">
          {{- section.settings.tagline_1 -}}
          {%- if section.settings.tagline_2 != blank -%}<span>{{ section.settings.tagline_2 }}</span>{%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OTO Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image (desktop)", "info": "Wide lifestyle photo, 2000px or larger recommended." },
    { "type": "image_picker", "id": "image_mobile", "label": "Banner image (mobile, optional)", "info": "Cropped version shown on phones. Falls back to the desktop image." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Natural men's wellness · 21+" },
    { "type": "text", "id": "heading", "label": "Heading (white)", "default": "Confidence" },
    { "type": "text", "id": "heading_accent", "label": "Heading second line (red)", "default": "Starts Here" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Natural support for stronger performance, greater vitality and a more satisfying you." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the 3-Pack" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Script tagline" },
    { "type": "text", "id": "tagline_1", "label": "Tagline line 1", "default": "A Stronger You" },
    { "type": "text", "id": "tagline_2", "label": "Tagline line 2", "default": "A Happier Us" }
  ],
  "presets": [{ "name": "OTO Hero" }]
}
{% endschema %}
