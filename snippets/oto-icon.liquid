{% doc %}
  Renders an outline icon used by the OTO sections.

  @param {string} name - leaf | shield | star | truck | lock | headset | bolt | bars | heart | check | arrow | plus | help | facebook | instagram | youtube | tiktok
  @param {string} [class] - extra CSS classes

  @example
  {% render 'oto-icon', name: 'leaf' %}
{% enddoc %}
<svg class="oto-icon{% if class != blank %} {{ class }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'leaf' -%}<path d="M20 4C12 4 5 7 5 14c0 3 2 5 5 5 7 0 10-7 10-15Z"/><path d="M4 20c3-5 7-8 12-11"/>
    {%- when 'shield' -%}<path d="M12 3 20 6v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-3Z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'star' -%}<path fill="currentColor" stroke="none" d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21 7 14.2 2 9.3l6.9-1L12 2Z"/>
    {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
    {%- when 'lock' -%}<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v2"/>
    {%- when 'headset' -%}<path d="M4 13v-2a8 8 0 0 1 16 0v2"/><path d="M4 13h3v6H5a1 1 0 0 1-1-1v-5ZM20 13h-3v6h2a1 1 0 0 0 1-1v-5Z"/>
    {%- when 'bolt' -%}<path d="m13 2-8 12h7l-1 8 8-10h-7l1-8Z"/>
    {%- when 'bars' -%}<path d="M4 20V12h3v8M10 20V8h3v12M16 20V4h3v16"/>
    {%- when 'heart' -%}<path d="M20.8 5.8a5.5 5.5 0 0 0-7.8 0L12 6.8l-1-1a5.5 5.5 0 0 0-7.8 7.8L12 22l8.8-8.4a5.5 5.5 0 0 0 0-7.8Z"/>
    {%- when 'check' -%}<path d="m5 12.5 4.2 4.2L19 7" stroke-width="2.2"/>
    {%- when 'arrow' -%}<path d="M5 12h14M14 7l5 5-5 5" stroke-width="2"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'help' -%}<path d="M4 5h16v11H11l-4 4v-4H4z"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.4M12 14.6v.01"/>
    {%- when 'facebook' -%}<path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v6h4v-6h3l1-4h-4V9c0-.7.3-1 1-1Z"/>
    {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
    {%- when 'youtube' -%}<path d="M21 12s0-4-1-6c-.5-1-1.5-1.5-3-1.7C15 4 12 4 12 4s-3 0-5 .3C5.5 4.5 4.5 5 4 6c-1 2-1 6-1 6s0 4 1 6c.5 1 1.5 1.5 3 1.7 2 .3 5 .3 5 .3s3 0 5-.3c1.5-.2 2.5-.7 3-1.7 1-2 1-6 1-6Z"/><path d="m10 9 5 3-5 3Z" fill="currentColor" stroke="none"/>
    {%- when 'tiktok' -%}<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.3 2.5 2 4.2 5 4.5"/>
  {%- endcase -%}
</svg>
