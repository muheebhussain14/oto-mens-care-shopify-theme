{% doc %}
  Red "Save NN%" pill. Renders nothing unless the variant has a compare-at price above its price.

  @param {object} variant - variant to compare
  @param {string} [class] - extra CSS classes

  @example
  {% render 'oto-save-pill', variant: product.selected_or_first_available_variant %}
{% enddoc %}
{%- if variant.compare_at_price > variant.price -%}
  {%- assign percent = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round -%}
  <span class="oto-pill{% if class != blank %} {{ class }}{% endif %}">{{ 'Save' }} {{ percent }}%</span>
{%- endif -%}
